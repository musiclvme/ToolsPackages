{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-personal-paths.py",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-personal-paths.py",
        "timeout": 10,
        "matcher": "git"
      }
    ]
  }
}
